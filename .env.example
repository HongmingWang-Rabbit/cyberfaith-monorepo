# Database
DATABASE_URL=postgresql://cyberfaith:cyberfaith@localhost:5432/cyberfaith

# Auth - Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Auth - JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Mock OAuth (local dev only — set AUTH_MOCK=true to use mock Google strategy)
# AUTH_MOCK=true
# MOCK_OAUTH_URL=http://localhost:9090

# AI Provider (openai | anthropic | google)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_AI_API_KEY=your-google-ai-api-key

# App URLs
CORE_API_URL=http://localhost:4000
WEBSITE_URL=http://localhost:3000
SANCTUM_URL=http://localhost:3001
DESTINY_LOOM_URL=http://localhost:3002
SANCTUARY_URL=http://localhost:3003

# Stripe (subscription billing)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_PRO=price_placeholder

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=CyberFaith <noreply@cyberfaith.app>

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@cyberfaith.app

# Frontend (prefix with NEXT_PUBLIC_ for client-side access)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000
